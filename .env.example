# Copy to .env, chmod 600 .env, and supply unique values. Never commit .env.
BIND_ADDRESS=127.0.0.1
# Set Y yourself only after reviewing the Microsoft SQL Server EULA.
ACCEPT_EULA=
MSSQL_PID=Developer
MSSQL_MEMORY_LIMIT_MB=2048
CATALINA_OPTS=-Xms256m -Xmx1536m
MSSQL_SA_PASSWORD=
APP_MOCK_PASSWORD=
HEALTHCHECK_PASSWORD=
IIQ_DB_PASSWORD=
IIQ_PLUGIN_PASSWORD=
IIQ_AH_PASSWORD=
LDAP_ADMIN_PASSWORD=
LDAP_BASE_DN=dc=corp1
LDAP_ORGANISATION=Org Corp1
LDAP_DATA_SCHEMA=./data/Application/ldap/bootstrap/schema/attributes.schema
LDAP_DATA=./data/Application/ldap/bootstrap/ldif/adata.ldif
DIRECTORY_TOMCAT_APPLICATION=./data/Application/file
# Generate with the licensed IIQ encrypt command; distinct database passwords.
IIQ_DB_PASSWORD_ENCRYPTED=
IIQ_PLUGIN_PASSWORD_ENCRYPTED=
IIQ_AH_PASSWORD_ENCRYPTED=
LDAP_PASSWORD_ENCRYPTED=
JDBC_PASSWORD_ENCRYPTED=
